# Copy to .env and fill in. .env is gitignored.

# --- Network ---
PORT=8080
PUBLIC_BASE_URL=http://localhost:3000

# --- Postgres (CC addon provides POSTGRESQL_ADDON_URI in prod) ---
DATABASE_URL=postgres://myccmonitor:myccmonitor@localhost:5432/myccmonitor
# POSTGRESQL_ADDON_URI=  # set by CC in prod, takes precedence

# --- Clever Cloud OAuth 1.0a (consumer key/secret are public, sourced from clever-tools) ---
CC_CONSUMER_KEY=T5nFjKeHH4AIlEveuGhB5S3xg8T19e
CC_CONSUMER_SECRET=MgVMqTr6fWlf2M0tkC2MXOnhfqBWDT
CC_API_BASE_URL=https://api.clever-cloud.com

# --- App-level encryption key for OAuth tokens at rest (32 bytes hex = 64 chars) ---
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# --- Apache Pulsar (CC addon in prod, local docker compose in dev) ---
PULSAR_BINARY_URL=pulsar://localhost:6650
PULSAR_TOKEN=
PULSAR_TENANT=public
PULSAR_NAMESPACE=default

# --- SMTP for email notifications (optional in dev) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Provided by Clever Cloud at runtime; defaults to "local" in dev ---
# INSTANCE_ID=

# --- Rust logging ---
RUST_LOG=info,sqlx=warn,tower_http=info
