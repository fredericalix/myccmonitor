# Copy to .env and fill in. .env is gitignored.

# --- Network ---
PORT=8080
PUBLIC_BASE_URL=http://localhost:3000

# --- Postgres (CC addon provides POSTGRESQL_ADDON_URI in prod) ---
DATABASE_URL=postgres://myccmonitor:myccmonitor@localhost:5432/myccmonitor
# POSTGRESQL_ADDON_URI=  # set by CC in prod, takes precedence

# --- Clever Cloud OAuth 1.0a ---
# myccmonitor needs ITS OWN OAuth consumer (the public clever-tools key
# T5nFjKeHH4AIlEveuGhB5S3xg8T19e does NOT accept arbitrary callback URLs in
# the request_token leg — CC returns 13502 "OAuth callback is invalid").
#
# Create one per environment (dev + prod), each with its callback whitelisted:
#
#   clever oauth-consumers create myccmonitor-dev \
#     --description "myccmonitor (dev)" \
#     --url       "http://localhost:3000" \
#     --base-url  "http://localhost:3000" \
#     --rights all
#   clever oauth-consumers get <key> --with-secret
#
# Then paste the result here:
CC_CONSUMER_KEY=
CC_CONSUMER_SECRET=
CC_API_BASE_URL=https://api.clever-cloud.com
WARP10_ENDPOINT=https://c2-warp10-clevercloud-customers.services.clever-cloud.com/api/v0/exec

# --- App-level encryption key for OAuth tokens at rest (32 bytes hex = 64 chars) ---
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# --- Apache Pulsar ---
# Reads PULSAR_BINARY_URL etc. first (explicit override), then falls back to
# ADDON_PULSAR_BINARY_URL etc. (what the CC addon injects). The addon variant
# is auto-set in prod by `clever service link-addon`.
#
# To populate from the dev addon:
#   clever addon env <addon-id> >> .env
#
# To use the local docker Pulsar standalone (no auth) instead, uncomment:
# PULSAR_BINARY_URL=pulsar://localhost:6650
# PULSAR_TENANT=public
# PULSAR_NAMESPACE=default
# PULSAR_TOKEN=

# --- SMTP for email notifications (optional in dev) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Provided by Clever Cloud at runtime; defaults to "local" in dev ---
# INSTANCE_ID=

# --- Rust logging ---
RUST_LOG=info,sqlx=warn,tower_http=info
